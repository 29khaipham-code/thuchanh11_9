@model IEnumerable<thuchanh11_9.Models.HangHoa>
@{
    ViewData["Title"] = "Home Page";
}


<div id="mainContent">
    <partial name="PhamNgocKhai_MainContent" model="@Model" />
</div>

@section Scripts {
    <script>
        $(document).on('click', '.loc-hang-hoa', function (e) {
            e.preventDefault();

            var maloai = $(this).data("maloai");

            $.ajax({
                url: '@Url.Action("LocHangHoa", "Home")',
                type: 'GET',
                data: {MaLoai : maloai},

                success: function (result) {
                    $("#mainContent").html(result);
                },

                error: function ( error) {
                    console.log(error);
                }

            })
        });
    </script>
}
